# PayPal REST sandbox (https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MODE=sandbox

# Exposed to the browser only if you add JS SDK buttons later
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Optional — local AI scorer works without this
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
